{
  "name": "fcu",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Football Club Universe offline football management prototype",
  "author": "FCU",
  "main": "dist-electron/main.js",
  "workspaces": [
    "apps/game",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:dream": "node scripts/dream-preview.mjs",
    "start": "electron .",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/test-e2e.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "probe": "node --experimental-strip-types scripts/probe.ts",
    "build": "vite build && node scripts/build.mjs",
    "package:win": "node scripts/package.mjs win32",
    "package:linux": "node scripts/package.mjs linux",
    "start:packaged": "node scripts/start-packaged.mjs",
    "steam:preview": "node scripts/steam-preview.ts",
    "roster:check": "node scripts/roster-check.ts",
    "roster:sync": "node scripts/roster-sync.ts",
    "roster:build": "node scripts/build-roster.mjs",
    "roster:start": "electron dist-roster-electron/main.js"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=12.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
