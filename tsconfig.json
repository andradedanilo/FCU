{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "WebWorker"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true, "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "tests", "scripts/*.ts", "*.ts"]
}
